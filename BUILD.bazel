load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "strictdoc_config.py",
    "requirements.txt",
])

# --- StrictDoc (sdoc) -------------------------------------------------------

# Run StrictDoc directly, e.g.:
#   bazel run //:strictdoc -- export . --output-dir=/tmp/sdoc-html
py_console_script_binary(
    name = "strictdoc",
    pkg = "@pip//strictdoc:pkg",
)

# `bazel test //:strictdoc_traceability_test` builds the StrictDoc
# documentation tree (every module's own docs/, src/, tests/ under
# modules/<name>/) and fails if any requirement <-> architecture <->
# source-code relation is broken.
py_test(
    name = "strictdoc_traceability_test",
    srcs = ["tests/strictdoc_traceability_test.py"],
    main = "tests/strictdoc_traceability_test.py",
    data = [
        ":strictdoc",
        ":strictdoc_config.py",
    ] + glob([
        "modules/**",
    ]),
    deps = ["@rules_python//python/runfiles"],
)

# --- Sphinx + sphinx-needs (Eclipse S-CORE's docs-as-code approach) --------

# Run Sphinx directly, e.g.:
#   bazel run //:sphinx-build -- -W -b html -c modules/docs_needs modules /tmp/needs-html
py_console_script_binary(
    name = "sphinx-build",
    pkg = "@pip//sphinx:pkg",
    # sphinx itself doesn't depend on sphinx-needs; add it explicitly so
    # `extensions = ["sphinx_needs"]` in modules/docs_needs/conf.py can be
    # imported.
    deps = ["@pip//sphinx_needs"],
)

# `bazel test //:sphinx_needs_traceability_test` builds the sphinx-needs
# documentation tree (modules/docs_needs/index.rst ties together every
# module's own docs_needs/) with `-W` (warnings-as-errors) and fails if any
# `:links:` reference is dangling. Note this only checks doc-to-doc links:
# unlike StrictDoc, sphinx-needs does not itself verify that the source
# paths mentioned as plain text in each module's implementation.rst and
# verification.rst actually exist -- see README.md for the full comparison.
py_test(
    name = "sphinx_needs_traceability_test",
    srcs = ["tests/sphinx_needs_traceability_test.py"],
    main = "tests/sphinx_needs_traceability_test.py",
    data = [
        ":sphinx-build",
    ] + glob([
        "modules/**",
    ]),
    deps = ["@rules_python//python/runfiles"],
)

# `bazel test //:traceability_tests` runs both back-to-back.
test_suite(
    name = "traceability_tests",
    tests = [
        ":sphinx_needs_traceability_test",
        ":strictdoc_traceability_test",
    ],
)

# --- C++ example system (7 modules) -----------------------------------------
#
# Each SW module owns a self-contained folder under modules/<name>/:
#   src/            implementation (cc_library below)
#   tests/          that module's own unit test (cc_test below)
#   docs/           StrictDoc requirements + architecture for this module
#   docs_needs/     the same content, as sphinx-needs
#
#   SensorInput -> MovingAverageFilter -> Controller -> RangeDiagnostics
#                                              |-> Logger
# plus a 7th, independent Simulink-MBD-generated module (speed_controller,
# below). The 6 hand-written modules' header/source carry an
# `@relation(ARCH-N, scope=file)` marker (see modules/<name>/docs/architecture.sdoc
# / modules/<name>/docs_needs/architecture.rst), so building and testing
# these targets is also what strictdoc_traceability_test and
# sphinx_needs_traceability_test rely on for the source-code side.

cc_library(
    name = "math_utils",
    srcs = ["modules/math_utils/src/math_utils.cpp"],
    hdrs = ["modules/math_utils/src/math_utils.h"],
)

cc_library(
    name = "sensor_input",
    srcs = ["modules/sensor_input/src/sensor_input.cpp"],
    hdrs = ["modules/sensor_input/src/sensor_input.h"],
)

cc_library(
    name = "signal_filter",
    srcs = ["modules/signal_filter/src/signal_filter.cpp"],
    hdrs = ["modules/signal_filter/src/signal_filter.h"],
)

cc_library(
    name = "diagnostics",
    srcs = ["modules/diagnostics/src/diagnostics.cpp"],
    hdrs = ["modules/diagnostics/src/diagnostics.h"],
)

cc_library(
    name = "logger",
    srcs = ["modules/logger/src/logger.cpp"],
    hdrs = ["modules/logger/src/logger.h"],
)

cc_library(
    name = "controller",
    srcs = ["modules/controller/src/controller.cpp"],
    hdrs = ["modules/controller/src/controller.h"],
    deps = [
        ":diagnostics",
        ":logger",
        ":math_utils",
        ":sensor_input",
        ":signal_filter",
    ],
)

# Every module's cc_test below links against googletest's gtest_main
# (bazel_dep in MODULE.bazel), which provides both the assertion macros
# and the test binary's main() entry point.

cc_test(
    name = "math_utils_test",
    srcs = ["modules/math_utils/tests/math_utils_test.cpp"],
    deps = [":math_utils", "@googletest//:gtest_main"],
)

cc_test(
    name = "sensor_input_test",
    srcs = ["modules/sensor_input/tests/sensor_input_test.cpp"],
    deps = [":sensor_input", "@googletest//:gtest_main"],
)

cc_test(
    name = "signal_filter_test",
    srcs = ["modules/signal_filter/tests/signal_filter_test.cpp"],
    deps = [":signal_filter", "@googletest//:gtest_main"],
)

cc_test(
    name = "diagnostics_test",
    srcs = ["modules/diagnostics/tests/diagnostics_test.cpp"],
    deps = [":diagnostics", "@googletest//:gtest_main"],
)

cc_test(
    name = "logger_test",
    srcs = ["modules/logger/tests/logger_test.cpp"],
    deps = [":logger", "@googletest//:gtest_main"],
)

cc_test(
    name = "controller_test",
    srcs = ["modules/controller/tests/controller_test.cpp"],
    deps = [
        ":controller",
        ":diagnostics",
        ":logger",
        ":sensor_input",
        ":signal_filter",
        "@googletest//:gtest_main",
    ],
)

# --- speed_controller: Simulink MBD-generated module (7th module) ----------
#
# Hand-authored to faithfully resemble Simulink Embedded Coder's actual
# generated-code structure (banner comments, ExtU_/ExtY_/DW_/P_ structs,
# <model>_initialize/_step/_terminate) -- see
# modules/speed_controller/models/speed_controller.md for the disclaimer
# and block diagram. Unlike the other six modules, these generated files
# carry NO `@relation(...)` source marker: they are not meant to be
# hand-edited, so ARCH-7 links to them via a doc-side `TYPE: File`
# relation instead (see modules/speed_controller/docs/architecture.sdoc).
# Only the hand-written test below carries the usual marker.
cc_library(
    name = "speed_controller",
    srcs = ["modules/speed_controller/src/speed_controller.c"],
    hdrs = [
        "modules/speed_controller/src/rtwtypes.h",
        "modules/speed_controller/src/speed_controller.h",
    ],
)

cc_test(
    name = "speed_controller_test",
    srcs = ["modules/speed_controller/tests/speed_controller_test.cpp"],
    deps = [":speed_controller", "@googletest//:gtest_main"],
)

# `bazel test //:cpp_module_tests` runs all 7 module unit tests.
test_suite(
    name = "cpp_module_tests",
    tests = [
        ":controller_test",
        ":diagnostics_test",
        ":logger_test",
        ":math_utils_test",
        ":sensor_input_test",
        ":signal_filter_test",
        ":speed_controller_test",
    ],
)
