load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "strictdoc_config.py",
    "requirements.txt",
])

# Run StrictDoc directly, e.g.:
#   bazel run //:strictdoc -- export . --output-dir=/tmp/sdoc-html
py_console_script_binary(
    name = "strictdoc",
    pkg = "@pip//strictdoc:pkg",
)

# `bazel test //:traceability_test` builds the StrictDoc documentation tree
# (docs/, src/, tests/) and fails if any requirement <-> architecture <->
# source-code relation is broken.
py_test(
    name = "traceability_test",
    srcs = ["tests/traceability_test.py"],
    main = "tests/traceability_test.py",
    data = [
        ":strictdoc",
        ":strictdoc_config.py",
    ] + glob([
        "docs/**",
        "src/**",
        "tests/**",
    ]),
    deps = ["@rules_python//python/runfiles"],
)
