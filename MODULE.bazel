module(
    name = "sdoctest",
    version = "0.1.0",
)

# Bazel-based documentation traceability test setup (StrictDoc / sdoc),
# following the same rules_python + Bzlmod approach used by
# eclipse-score/docs-as-code for its Sphinx-needs based traceability tooling.

bazel_dep(name = "rules_python", version = "1.8.5")

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")
