module(
    name = "sdoctest",
    version = "0.1.0",
)

# Bazel-based documentation traceability test setup comparing StrictDoc
# (sdoc) against Sphinx + sphinx-needs -- the tool eclipse-score/docs-as-code
# actually uses -- over a shared C++ example (modules/<name>/{src,tests}).
# The C++ side uses Bazel's built-in cc_library/cc_test rules and needs no
# extra bazel_dep for the toolchain itself: the host C/C++ toolchain is
# auto-detected via @bazel_tools. googletest below is only the unit test
# framework each module's cc_test links against.

bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")
